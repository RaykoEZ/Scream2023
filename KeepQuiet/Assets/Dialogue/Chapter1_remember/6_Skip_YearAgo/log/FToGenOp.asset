  - ChatLog:
      WhoSpoke: D002-FGZ1
      Content: "Ms Yanagi is safe but in critical conditions, \nand will likely be
        hospitalized for 12 months."
      AttachmentId: 
    HasAudio: 1
    DelayBeforeTyping: 2
    TypingDelay: 2
    WhoSpoke: D002-FGZ1
    SentPrefabRef: {fileID: 0}
    Content: She is safe but in critical conditions, and will likely be hospitalized
