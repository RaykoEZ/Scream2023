    ObtainThought: {fileID: 0}
    TriggerAfterThisLine: {fileID: 0}
  - ChatLog:
      WhoSpoke: D002-FGZ1
      Content: "We cannot guarantee a full recovery, this is a difficult \ncase to
        remedy with our current technology."
      AttachmentId: 
    HasAudio: 1
    DelayBeforeTyping: 2
    TypingDelay: 5
    WhoSpoke: D002-FGZ1
    SentPrefabRef: {fileID: 0}
    Content: "It's going to be 12 months at the very least.\n\nI cannot guarantee
      a full recovery, a fatal head injury \nis a difficult case to remedy with our
      current technology."
    ObtainThought: {fileID: 0}
    TriggerAfterThisLine: {fileID: 0}
  - ChatLog:
      WhoSpoke: D002-FGZ1
      Content: "Experiemental procedures are available. \nWe will need to discuss
        this separately, with the relevant parties.\n\nAs her manager, you are invited
        to a meetng on this topic\nat Administration District, Block 2, F15\non 12/12/E1C5,
        1523\n\nRegards, GenOp Health Dpt."
      AttachmentId: 
