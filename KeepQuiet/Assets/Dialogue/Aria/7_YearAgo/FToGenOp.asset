MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3599f2d4d0955ff4e838c88551c18ddf, type: 3}
  m_Name: FToGenOp
  m_EditorClassIdentifier: 
  m_dialogues:
  - HasAudio: 1
    DelayBeforeTyping: 0.2
    TypingDelay: 1.2
    WhoSpoke: D002-FGZ1
    SentPrefabRef: {fileID: 0}
    Content: I want to give you some heads up regarding Ms Aria's situation.
    TriggerAfterThisLine: {fileID: 0}
  - HasAudio: 1
    DelayBeforeTyping: 0.5
    TypingDelay: 1
    WhoSpoke: F
    SentPrefabRef: {fileID: 0}
    Content: Let's hear it.
    TriggerAfterThisLine: {fileID: 0}
  - HasAudio: 1
    DelayBeforeTyping: 2
    TypingDelay: 2
    WhoSpoke: D002-FGZ1
    SentPrefabRef: {fileID: 0}
    Content: She is safe but in critical conditions, and will likely be hospitalized
      for a long time.
    TriggerAfterThisLine: {fileID: 0}
  - HasAudio: 1
    DelayBeforeTyping: 2
    TypingDelay: 2
    WhoSpoke: F
    SentPrefabRef: {fileID: 0}
    Content: "How long will it be? \n\nWill there be any long-term problems?\n"
    TriggerAfterThisLine: {fileID: 0}
  - HasAudio: 1
    DelayBeforeTyping: 2
    TypingDelay: 5
    WhoSpoke: D002-FGZ1
    SentPrefabRef: {fileID: 0}
    Content: "It's going to be 12 months at the very least.\n\nI cannot guarantee
      a full recovery, a fatal head injury \nis a difficult case to remedy with our
      current technology."
    TriggerAfterThisLine: {fileID: 0}
  - HasAudio: 1
    DelayBeforeTyping: 0.1
    TypingDelay: 5
    WhoSpoke: D002-FGZ1
    SentPrefabRef: {fileID: 0}
    Content: "Experiemental treatment is available, but we will need to discuss\nthis
      separately, with the relevant parties.\n\nAs her manager, you are invited to
      this discussion \nat Administration District, Block 2, F15\non12/12/E1C5, 1523"
    TriggerAfterThisLine: {fileID: 0}
  m_replyOptions: []
  m_hiddenOptions: {fileID: 0}
